# Optional. The site already connects to B2 Rental's Supabase project by default
# (see src/lib/supabase.js). Copy to .env.local only to point at a different project:
# VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
#
# Run the site in browser-only demo mode (no shared database):
# VITE_DEMO_MODE=true
